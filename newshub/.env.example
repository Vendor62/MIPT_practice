# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=newshub
DB_USER=newshub
DB_PASSWORD=change_me

# Redis (Celery broker + cache)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_too

# Telegram bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# IE (NLP models)
IE_TORCH_DEVICE=cpu
IE_GLINER_MODEL=urchade/gliner_multi-v2.1
IE_MREBEL_MODEL=Babelscape/mrebel-large

# Storyline parameters
STORYLINE_SIMILARITY_THRESHOLD=0.75
STORYLINE_TIME_WINDOW_DAYS=7

# Crypto Pay (Premium subscription payments)
CRYPTOPAY_API_TOKEN=your_cryptopay_token_here
CRYPTOPAY_WEBHOOK_SECRET=change_me

# Events
TELEHUB_EVENTS_EXCHANGE=newshub.events
